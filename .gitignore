# --- Webapp Dynamic Runtime Data ---
webapp/workspaces/
workspaces/
*.log
cookies.txt

# --- Python & Pytest Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# --- Virtual Environments ---
venv/
.venv/
env/
.env

# --- OS & Editor Metadata ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
